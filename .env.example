# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# จำเป็น: token ของบอทจาก Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# prefix ของคำสั่งแบบพิมพ์ (ค่าเริ่มต้น !)
PREFIX=!

# ไม่บังคับ: argument เพิ่มเติมให้ yt-dlp เช่น ใช้ cookies เมื่อ YouTube ขอให้ยืนยันว่าไม่ใช่บอท
# YTDLP_ARGS=--cookies C:\path\to\cookies.txt
YTDLP_ARGS=

# ไม่บังคับ: รหัสผ่านหน้าเว็บจัดการ http://localhost:8080 (ไม่ใส่ = สุ่มใหม่ทุกครั้ง ดูได้ใน log)
WEB_PASSWORD=
# ไม่บังคับ: ที่อยู่หน้าเว็บ (ค่าเริ่มต้น 127.0.0.1:8080 = เปิดได้จากเครื่องนี้เท่านั้น, off = ปิดหน้าเว็บ)
# WEB_ADDR=127.0.0.1:8080
